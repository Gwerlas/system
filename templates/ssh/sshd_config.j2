# Ansible managed, do not edit

# This is the sshd server system-wide configuration file.  See
# sshd_config(5) for more information.

{% for key, value in config.items() if (key | lower) == 'include' %}
# Make sure that all Match options are below this Include!
{{ key }} "{{ value }}"

{% endfor %}
{% for key, value in config.items() if (key | lower) not in ['include', 'match'] %}

{% if (key | lower) in (list_separated_by_comma | map('lower')) %}
{% if value is not string and value is iterable %}
{{ key }} {{ value | join(',') }}
{% else %}
{{ key }} {{ value }}
{% endif %}
{% elif value is not string and value is iterable %}
{% for v in value %}
{{ key }} {{ v }}
{% endfor %}

{% elif value is boolean %}
{{ key }} {{ value | ternary('yes', 'no') }}
{% else %}
{{ key }} {{ value }}
{% endif %}
{% endfor %}

