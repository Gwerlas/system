#!/usr/bin/env bash
#
# Ansible managed, do not edit
#
# Detection script to determine if the package manager cache need to be updated
#
# Return codes :
#
# 0 = Do not need to update cache
# 1 = Need updating

set -e

{% if packages_cache_age | string == 'never' %}
# The index is frozen on purpose (system_packages_cache_age: never)
exit 0
{% elif packages_cache_age | int == 0 %}
# Refresh on every run (system_packages_cache_age: 0)
exit 1
{% else %}
{% if 'files' in pkg_mgr_cache_update_policy %}
test_file() {
  test -f "$1"

  # file age
  local mtime=$(stat --printf '%y' "$1")
  local ts=$(date +%s -d "$mtime")

  test $ts -gt $(date +%s -d "$2 days ago")
}

{% for file in pkg_mgr_cache_update_policy.files %}
test_file {{ file.path }} {{ file.age | default(packages_cache_age) }}
{% endfor %}
{% endif %}

{% if 'directories' in pkg_mgr_cache_update_policy %}
test_dir() {
  test $(ls -1 "$1" | wc -l) -gt 0

  # -maxdepth 0: the index files keep the mirror's Last-Modified, only the
  # directory itself is stamped with our last refresh.
  local matches=$(find "$1" -maxdepth 0 -mtime -$(( $2 + 1 )) | wc -l)
  test $matches -gt 0  
}

{% for directory in pkg_mgr_cache_update_policy.directories %}
test_dir {{ directory.path }} {{ directory.age | default(packages_cache_age) }}
{% endfor %}
{% endif %}
{% endif %}
